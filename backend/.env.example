# Copy to .env (never commit) or export these before starting the API.
DB_URL=jdbc:mysql://localhost:3306/skillswap_db?createDatabaseIfNotExist=true
DB_USERNAME=skillswap_app
DB_PASSWORD=change-me
# Long random string; keeps logins valid across restarts. Generate: openssl rand -base64 48
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=12
# Optional: create first admin on empty DB
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
